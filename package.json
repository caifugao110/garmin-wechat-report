{
  "name": "garmin-daily-report",
  "version": "1.0.0",
  "description": "Daily Garmin Connect health report pushed to WeChat via Server酱 (Node / GitHub Actions / Cloudflare Workers)",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "worker:dev": "wrangler dev",
    "worker:dry-run": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.90.0"
  },
  "engines": {
    "node": ">=20"
  }
}
