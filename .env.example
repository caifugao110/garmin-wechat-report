# Garmin 账号（GitHub Actions 用 Secrets 注入；本地用 .env）
GARMIN_USERNAME=your_email@example.com
GARMIN_PASSWORD=your_password

# Server酱 SendKey（https://sct.ftqq.com 免费获取）
SERVERCHAN_SENDKEY=SCTxxxxxxxx

# 可选：设为 1 时只生成报告不推送（本地调试用）
DRY_RUN=0

# 可选（GitHub Actions 推荐）：在本机执行 npm run token 生成。
# 配置后运行时跳过 SSO 账号密码登录，绕开 Actions 机房 IP 被 Garmin 风控的问题。
GARMIN_OAUTH1_TOKEN=
GARMIN_OAUTH1_TOKEN_SECRET=

# 可选：DeepSeek / OpenAI 兼容 AI 分析（接入后会在报告末尾追加一段 AI 建议）
# DeepSeek 控制台申请：https://platform.deepseek.com
# 其他兼容服务（通义/Moonshot/OpenAI）把 BASE_URL / MODEL 改成对应值即可，见 README
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 可选：企业微信群机器人推送（配置后除 Server酱外再推送一份到企业微信群）
# 获取方式：企业微信群 → 右上角 ... → 群机器人 → 添加机器人 → 复制 Webhook 地址中 key= 后面的部分
# 完整地址形如 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WECOM_BOT_KEY=
